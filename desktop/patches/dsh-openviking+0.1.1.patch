+ * command line is unreadable, so the answer is false and nothing is killed.
+ * @param pid - process id from the lock file.
+ * @param deps - injected for tests: `alive(pid)` and `cmdline(pid)`.
+ * @returns true only for a verified OpenViking process.
+ */
+export function isOpenVikingProcess(pid, deps = processProbe) {
+  if (!Number.isInteger(pid) || pid <= 0 || !deps.alive(pid)) return false
+  const cmdline = deps.cmdline(pid)
+  return typeof cmdline === 'string' && cmdline.toLowerCase().includes('openviking')
