node_modules/
out/
dist/
dist-dev/
.DS_Store
*.log
coverage/
/doc/
/deliverables/
build/icon.iconset/
build/app-icon.iconset/
build/icon-1024.png
# Staged by scripts/install-python-runtime.mjs; the pinned URL + SHA256 in
# that script (not this checkout) is the source of truth, same reasoning as
# dist/dist-dev above.
build/python-runtime/
.env
.env.*
!.env.example
.coaligne/
.coaligneignore

# The repository root ignores every `lib/` because harness packages build into
# one. dshmarket ships its runtime checked in, so re-include the directory here
# (a deeper .gitignore overrides the root's pattern).
!packages/*/lib/


# Python bytecode from release-note scripts / tests
__pycache__/
*.pyc
