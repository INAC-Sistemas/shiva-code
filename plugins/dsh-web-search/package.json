{
  "name": "dsh-web-search",
  "version": "0.1.0",
  "description": "DSH keyless web search: registers a DuckDuckGo search provider on the harness web seam so the agents' native web_search tool works with no API key, plus a sidebar tab to try it",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.12.0",
    "react": "^18.2.0"
  },
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "lib"
  ]
}
