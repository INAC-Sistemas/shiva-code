{
  "name": "dsh-browser",
  "version": "0.2.3",
  "description": "Agent control for the better-sidebar browser tab: open it, navigate to a URL, screenshot the app window showing it, and open external URLs in the system browser",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-prototype": ">=0.1.7"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.12.0",
    "react": "^18.2.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib"
  ]
}
